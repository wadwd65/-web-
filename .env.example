# Optional public URL of your own backend, including the version prefix.
# Empty keeps all eight business tools local and sends no documents.
# Example after the backend exists: VITE_API_BASE_URL=/api/v1
VITE_API_BASE_URL=
# Never put model keys, private tokens or personal documents in VITE_* variables.

# Private Node-server configuration; use .env.local, never commit actual values.
# Also supports ~/.config/first-step/.env.local or FIRST_STEP_AI_ENV_FILE.
DEEPSEEK_API_KEY=
FIRST_STEP_AI_MODEL=deepseek-flash

# Deployment process environment, set in your hosting panel or service manager.
# FIRST_STEP_PUBLIC_ORIGIN=https://your-domain.example
# FIRST_STEP_HOST=0.0.0.0
# PORT=5186
# The public origin must be an HTTPS origin with no path. Keep Host and Origin
# intact through the reverse proxy. Local previews keep the loopback defaults.
# These deployment values are read from process.env, not from the key file.

# Optional process environment variable FIRST_STEP_DATA_DIR overrides the private
# account database directory. Default: ~/.config/first-step/private-data.
# Never store that directory, SQLite files, or real user materials in the repository.
